{
  "root": true,
  "extends": [
    "plugin:@wordpress/eslint-plugin/recommended"
  ],
  "env": {
    "browser": true,
    "jquery": true,
    "es6": true
  },
  "globals": {
    "wp": "readonly",
    "hbc_ajax": "readonly"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "warn",
    "prefer-const": "warn",
    "no-var": "off",
    "camelcase": "off",
    "jsdoc/require-jsdoc": "off",
    "jsdoc/require-param": "off",
    "jsdoc/require-returns": "off"
  },
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "script"
  }
}
